<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ViewSettingsDialog confirm="handleSortDialogConfirm" sortDescending="true" resetFilters="onResetSort">
        <sortItems>
            <ViewSettingsItem text="{i18n>nombre}" key="DATA_AUTH0/name"/>
            <ViewSettingsItem text="{i18n>correo}" key="EMAIL"/>
            <ViewSettingsItem text="{i18n>tipoUsuario}" key="DESCRIPTION_USERTYPE"/>
            <ViewSettingsItem text="{i18n>ultimaActualizacion}" key="DATA_AUTH0/updated_at" selected="true"/>
            <ViewSettingsItem text="{i18n>estadoAuth0}" key="BLOCKED_AUTH0_TEXT"/>
            <ViewSettingsItem text="{i18n>estadoPortal}" key="DESCRIPTION_USERSTATUS"/>
        </sortItems>
    </ViewSettingsDialog>
</core:FragmentDefinition>
