<core:FragmentDefinition xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout">
    <Dialog id="oDialogAdd" title="Nuevo usuario" type='Message' class="sapUiNoContentPadding" contentWidth="450px">
        <content>
            <l:Grid vSpacing="0.5" hSpacing="0.5" width="100%" class="sapUiTinyMargin">
                <VBox>
                    <Label text="Correo" required="true"/>
                    <Input id="oInputCorreoUsuarioId" width="100%" liveChange="formatoCorreo" maxLength="300" value=""/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombre" required="true"/>
                    <Input id="oInputNombreUsuarioId" width="100%" maxLength="300" value=""/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Tipo usuario" required="true"/>
                    <Select id="oSelectTipoUsuarioId" width="100%" items="{path: 'oModelTipoUsuario>/', sorter: {path: 'DESCRIPTION'}, filters: [{path: 'DELETESTATUS',operator: 'EQ', value1: '1'}]}">
                        <core:Item text="{oModelTipoUsuario>DESCRIPTION}" key="{oModelTipoUsuario>USERTYPEID}"></core:Item>
                    </Select>
                    <layoutData>
                        <l:GridData span="XL7 L7 M7 S7"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Estado portal" required="true"/>
                    <Select id="oSelectEstadoPortalId" enabled="false" width="100%" selectedKey="10" items="{path: 'oModelEstadoPortal>/', sorter: {path: 'DESCRIPTION'}, filters: [{path: 'DELETESTATUS',operator: 'EQ', value1: '1'}]}">
                        <core:Item text="{oModelEstadoPortal>DESCRIPTION}" key="{oModelEstadoPortal>USERSTATUSID}"></core:Item>
                    </Select>
                    <layoutData>
                        <l:GridData span="XL5 L5 M5 S5"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Estado auth0" required="true"/>
                    <Select id="oSelectEstadoAuth0Id" enabled="false" selectedKey="false" width="100%" items="{path: 'oModelEstadoAuth0>/', sorter: {path: 'text'}}">
                        <core:Item text="{oModelEstadoAuth0>text}" key="{oModelEstadoAuth0>key}"></core:Item>
                    </Select>
                    <layoutData>
                        <l:GridData span="XL4 L4 M4 S4"/>
                    </layoutData>
                </VBox>
            </l:Grid>
        </content>
        <beginButton>
            <Button text="Guardar" type="Emphasized" press="addUsuario"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="cerrarDialogoAdd"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>