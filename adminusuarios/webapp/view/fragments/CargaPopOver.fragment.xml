
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:u="sap.ui.unified" height="100%">
    <Dialog title="{i18n>cargaMasivaUsuarios}" class="sapUiContentPadding" contentWidth="500px">
        <content>
            <u:FileUploader id="idfileUploader" change="onChangeUploadFile" width="100%" sameFilenameAllowed="false" buttonText="{i18n>adjuntar}" fileType="CSV"
                placeholder="{i18n>adjunteArchivoCSV}" style="Transparent"></u:FileUploader>
            <Text
                text="{i18n>importanteCargaMasiva}"
                wrapping="true"></Text>
            <VBox class="sapUiSmallMarginTop" justifyContent="Start" alignItems="Start">
                <Link text="{i18n>descargarFormato}" press="descargarFormatoCargaMasiva"></Link>
            </VBox>
        </content>
        <buttons>
            <Button id="cargar" text="{i18n>cargar}" press="onUpload" type="Emphasized"/>
            <Button id="close" text="{i18n>cancelar}" press="cerrarDialogoCargaMasiva"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
